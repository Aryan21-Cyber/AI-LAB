# Tic-Tac-Toe Game

board = [" " for i in range(9)]

player = "X"

def display_board():
    print()
    print(board[0], "|", board[1], "|", board[2])
    print("--+--+--")
    print(board[3], "|", board[4], "|", board[5])
    print("--+--+--")
    print(board[6], "|", board[7], "|", board[8])
    print()

def check_winner():
    winning_positions = [
        (0, 1, 2),
        (3, 4, 5),
        (6, 7, 8),
        (0, 3, 6),
        (1, 4, 7),
        (2, 5, 8),
        (0, 4, 8),
        (2, 4, 6)
    ]

    for a, b, c in winning_positions:
        if board[a] == board[b] == board[c] != " ":
            return True

    return False

for turn in range(9):

    display_board()

    position = int(input("Player " + player + ", enter position (1-9): ")) - 1

    if board[position] == " ":
        board[position] = player
    else:
        print("Invalid Move!")
        continue

    if check_winner():
        display_board()
        print("Player", player, "Wins!")
        break

    if player == "X":
        player = "O"
    else:
        player = "X"

else:
    display_board()
    print("Game Draw!")
